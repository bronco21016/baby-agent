# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Huckleberry account credentials
HUCKLEBERRY_EMAIL=you@example.com
HUCKLEBERRY_PASSWORD=yourpassword

# Timezone for the Huckleberry API (IANA format)
HUCKLEBERRY_TIMEZONE=America/New_York

# Session expiry in seconds (default: 1800 = 30 min)
SESSION_TTL_SECONDS=1800

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# Claude thinking effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# Claude model for the main agent loop
CLAUDE_MODEL=claude-sonnet-5

# Claude model for the conversation-done classifier (cheap/fast; no thinking)
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5

# Path for JSONL conversation log (default: conversations.jsonl in working directory)
# CONVERSATION_LOG_PATH=conversations.jsonl
